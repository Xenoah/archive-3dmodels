---
import BaseLayout from "../layouts/BaseLayout.astro";
import models from "../data/models.generated.json";

const publicModels = models.filter((model) => model.status === "public");
const listedModels = models.filter((model) => model.status === "public" || model.status === "draft");
const categories = [...new Set(listedModels.map((model) => model.category).filter(Boolean))].sort();
const tags = [...new Set(listedModels.flatMap((model) => model.tags ?? []))].sort();
const licenses = [...new Set(listedModels.map((model) => model.license).filter(Boolean))].sort();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const latest = listedModels.slice(0, 3);
---

<BaseLayout
  title="3D Models"
  description="Browse downloadable 3D models by category, tag, and license."
>
  <section class="intro" aria-labelledby="page-title">
    <div>
      <h1 id="page-title">3D Models</h1>
      <p>
        A lightweight static archive for downloadable 3D model files. Pages, metadata,
        galleries, and ZIP downloads are generated from Markdown and source folders.
      </p>
      <div class="hero-actions">
        <a class="button" href="#model-grid">Browse models</a>
        <a class="ghost-button" href={`${base}/terms/`}>License terms</a>
      </div>
    </div>
    <aside class="hero-panel" aria-label="Archive summary">
      <div class="panel-topline">Archive Status</div>
      <div class="stats">
        <div class="stat">
          <strong>{publicModels.length}</strong>
          <span>Public</span>
        </div>
        <div class="stat">
          <strong>{categories.length}</strong>
          <span>Categories</span>
        </div>
        <div class="stat">
          <strong>{tags.length}</strong>
          <span>Tags</span>
        </div>
      </div>
      <div class="latest-list">
        {latest.length === 0 ? (
          <span>No models yet</span>
        ) : (
          latest.map((model) => <a href={`${base}/${model.slug}/`}>{model.title}</a>)
        )}
      </div>
    </aside>
  </section>

  <form class="toolbar" id="model-filter" role="search">
    <input id="q" type="search" placeholder="Search title, summary, tag" aria-label="Keyword search" />
    <select id="category" aria-label="Category">
      <option value="">All categories</option>
      {categories.map((category) => <option value={category}>{category}</option>)}
    </select>
    <select id="tag" aria-label="Tag">
      <option value="">All tags</option>
      {tags.map((tag) => <option value={tag}>{tag}</option>)}
    </select>
    <select id="license" aria-label="License">
      <option value="">All licenses</option>
      {licenses.map((license) => <option value={license}>{license}</option>)}
    </select>
    <select id="sort" aria-label="Sort order">
      <option value="updated-desc">Newest first</option>
      <option value="title-asc">Name A-Z</option>
      <option value="category-asc">Category</option>
    </select>
  </form>

  {
    listedModels.length === 0 ? (
      <div class="empty">
        <strong>No models yet.</strong>
        <p>Add a model under content/models or import files from _inbox.</p>
      </div>
    ) : (
      <section class="model-grid" id="model-grid" aria-label="Model list">
        {listedModels.map((model) => (
          <a
            class="model-card"
            href={`${base}/${model.slug}/`}
            data-title={model.title.toLowerCase()}
            data-summary={(model.summary || "").toLowerCase()}
            data-body={(model.bodyText || "").toLowerCase()}
            data-category={model.category}
            data-tags={(model.tags ?? []).join(" ")}
            data-license={model.license}
            data-updated={model.updated || ""}
          >
            <div class="thumb">
              {model.status === "draft" && <div class="draft-badge">DRAFT</div>}
              {model.assets.cover ? (
                <img src={model.assets.cover} alt="" loading="lazy" />
              ) : (
                <div class="model-fallback" aria-hidden="true">
                  <div class="cube-mark">
                    <span></span>
                    <span></span>
                    <span></span>
                  </div>
                  <strong>STL</strong>
                </div>
              )}
            </div>
            <div class="card-body">
              <div>
                <h2>{model.title}</h2>
                <p class="summary">{model.summary || "No summary provided."}</p>
              </div>
              <div class="meta-row">
                <span class="pill">{model.category}</span>
                <span class="pill">{model.license}</span>
                {model.updated && <span class="pill">{model.updated}</span>}
              </div>
              <div class="tag-row">
                {(model.tags ?? []).slice(0, 5).map((tag) => <span class="pill">#{tag}</span>)}
              </div>
            </div>
          </a>
        ))}
      </section>
    )
  }

  <script>
    const form = document.querySelector("#model-filter");
    const cards = [...document.querySelectorAll(".model-card")];
    const fields = {
      q: document.querySelector("#q"),
      category: document.querySelector("#category"),
      tag: document.querySelector("#tag"),
      license: document.querySelector("#license"),
      sort: document.querySelector("#sort")
    };

    function filterCards() {
      const q = fields.q.value.trim().toLowerCase();
      const category = fields.category.value;
      const tag = fields.tag.value;
      const license = fields.license.value;
      const sort = fields.sort.value;
      const grid = document.querySelector("#model-grid");

      const sortedCards = [...cards].sort((a, b) => {
        if (sort === "title-asc") return a.dataset.title.localeCompare(b.dataset.title);
        if (sort === "category-asc") {
          return `${a.dataset.category} ${a.dataset.title}`.localeCompare(`${b.dataset.category} ${b.dataset.title}`);
        }
        return (b.dataset.updated || "").localeCompare(a.dataset.updated || "") || a.dataset.title.localeCompare(b.dataset.title);
      });
      for (const card of sortedCards) grid?.append(card);

      for (const card of cards) {
        const haystack = `${card.dataset.title} ${card.dataset.summary} ${card.dataset.tags} ${card.dataset.body}`;
        const visible =
          (!q || haystack.includes(q)) &&
          (!category || card.dataset.category === category) &&
          (!tag || card.dataset.tags.split(" ").includes(tag)) &&
          (!license || card.dataset.license === license);
        card.hidden = !visible;
      }
    }

    form?.addEventListener("input", filterCards);
  </script>
</BaseLayout>
