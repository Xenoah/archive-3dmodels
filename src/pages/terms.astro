---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout title="Terms | 3D Models" description="License and download terms for the 3D model archive.">
  <a class="ghost-button" href={`${base}/`}>Back to models</a>
  <section class="intro">
    <div>
      <h1>Terms</h1>
      <p>
        Each model page is the source of truth for license, commercial use, modification,
        redistribution, and credit requirements. For Original licenses, read the model notes too.
      </p>
    </div>
  </section>
  <section class="section markdown">
    <h2>Download</h2>
    <p>ZIP files include source files plus generated README and LICENSE text.</p>
    <h2>Draft</h2>
    <p>Draft models are excluded from listings, detail pages, and ZIP generation.</p>
  </section>
</BaseLayout>
