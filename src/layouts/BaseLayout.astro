---
import "../styles/global.css";

const {
  title = "3Dモデル",
  titleEn = "3D Models",
  description = "ダウンロード可能な3Dモデルの静的アーカイブです。",
  descriptionEn = "3D model archive for downloads.",
  image = "",
  robots = "index, follow",
  jsonLd = []
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = Astro.url.href;
const siteUrl = new URL(`${base}/`, Astro.site).href;
const sitemapUrl = new URL(`${base}/sitemap.xml`, Astro.site).href;
const imageUrl = image ? new URL(image, Astro.site).href : "";
const googleSiteVerification =
  import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION ?? "aPtYwfsh75Fol8ou1AKrAWZXEAKl97LEWKER4G2wiuQ";
const defaultJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Xenoah 3D Models",
  alternateName: "Xenoah 3Dモデル",
  url: siteUrl,
  inLanguage: ["ja", "en"],
  creator: {
    "@type": "Person",
    name: "Xenoah"
  }
};
const jsonLdItems = [defaultJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])].filter(Boolean);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Xenoah 3D Models" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script>
      const savedViewer = localStorage.getItem("archive-3dmodels-viewer");
      document.documentElement.dataset.viewerEnabled = savedViewer === "off" ? "false" : "true";
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PHNBTBWCDK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-PHNBTBWCDK");
    </script>
    <link rel="alternate" type="application/rss+xml" title="3D Models RSS" href={`${base}/rss.xml`} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none';"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <nav class="nav" aria-label="Global">
          <a class="brand" href={`${base}/`}>
            <strong>Xenoah 3D Models</strong>
            <span data-lang-ja="Xenoah による静的配布アーカイブ" data-lang-en="Static distribution archive by Xenoah">Xenoah による静的配布アーカイブ</span>
          </a>
          <div class="nav-links">
            <a href={`${base}/`} data-lang-ja="モデル" data-lang-en="Models">モデル</a>
            <a href={`${base}/terms/`} data-lang-ja="規約" data-lang-en="Terms">規約</a>
            <a href={`${base}/rss.xml`}>RSS</a>
            <button
              type="button"
              class="viewer-switch"
              data-viewer-switch
              aria-pressed="true"
              data-lang-ja="3D ON"
              data-lang-en="3D ON"
            >
              3D ON
            </button>
            <div class="language-switch" aria-label="Language">
              <button type="button" data-lang-switch="ja" aria-pressed="true">JP</button>
              <button type="button" data-lang-switch="en" aria-pressed="false">EN</button>
            </div>
          </div>
        </nav>
      </header>
      <main class="main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="inner">
          <span
            data-lang-ja="Created by Xenoah. Markdown とソースファイルから静的な HTML、CSS、JavaScript として生成しています。"
            data-lang-en="Created by Xenoah. Generated as static HTML, CSS, and JavaScript from Markdown and source files."
          >
            Created by Xenoah. Markdown とソースファイルから静的な HTML、CSS、JavaScript として生成しています。
          </span>
        </div>
      </footer>
    </div>
    <script define:vars={{ title, titleEn, description, descriptionEn }}>
      const languageKey = "archive-3dmodels-language";
      const viewerKey = "archive-3dmodels-viewer";
      const supportedLanguages = new Set(["ja", "en"]);

      function getSavedLanguage() {
        const saved = localStorage.getItem(languageKey);
        return supportedLanguages.has(saved) ? saved : "ja";
      }

      function setMetaContent(selector, value) {
        const element = document.querySelector(selector);
        if (element) element.setAttribute("content", value);
      }

      function applyLanguage(language) {
        const lang = supportedLanguages.has(language) ? language : "ja";
        document.documentElement.lang = lang;
        document.documentElement.dataset.lang = lang;
        document.title = lang === "en" ? titleEn : title;
        setMetaContent('meta[name="description"]', lang === "en" ? descriptionEn : description);
        setMetaContent('meta[property="og:title"]', lang === "en" ? titleEn : title);
        setMetaContent('meta[property="og:description"]', lang === "en" ? descriptionEn : description);
        setMetaContent('meta[name="twitter:title"]', lang === "en" ? titleEn : title);
        setMetaContent('meta[name="twitter:description"]', lang === "en" ? descriptionEn : description);

        document.querySelectorAll("[data-lang-ja][data-lang-en]").forEach((element) => {
          element.textContent = element.dataset[`lang${lang === "en" ? "En" : "Ja"}`] ?? "";
        });
        document.querySelectorAll("[data-lang-placeholder-ja][data-lang-placeholder-en]").forEach((element) => {
          element.setAttribute(
            "placeholder",
            element.dataset[`langPlaceholder${lang === "en" ? "En" : "Ja"}`] ?? ""
          );
        });
        document.querySelectorAll("[data-lang-aria-label-ja][data-lang-aria-label-en]").forEach((element) => {
          element.setAttribute(
            "aria-label",
            element.dataset[`langAriaLabel${lang === "en" ? "En" : "Ja"}`] ?? ""
          );
        });
        document.querySelectorAll("[data-lang-switch]").forEach((button) => {
          button.setAttribute("aria-pressed", button.dataset.langSwitch === lang ? "true" : "false");
        });
        localStorage.setItem(languageKey, lang);
        window.dispatchEvent(new CustomEvent("archive-language-change", { detail: { language: lang } }));
      }

      document.querySelectorAll("[data-lang-switch]").forEach((button) => {
        button.addEventListener("click", () => applyLanguage(button.dataset.langSwitch));
      });

      function applyViewerPreference(enabled) {
        const isEnabled = enabled !== false;
        document.documentElement.dataset.viewerEnabled = isEnabled ? "true" : "false";
        localStorage.setItem(viewerKey, isEnabled ? "on" : "off");
        document.querySelectorAll("[data-viewer-switch]").forEach((button) => {
          button.setAttribute("aria-pressed", isEnabled ? "true" : "false");
          button.dataset.langJa = isEnabled ? "3D ON" : "3D OFF";
          button.dataset.langEn = isEnabled ? "3D ON" : "3D OFF";
          button.textContent = isEnabled ? "3D ON" : "3D OFF";
        });
        window.dispatchEvent(new CustomEvent("archive-viewer-preference-change", { detail: { enabled: isEnabled } }));
      }

      document.querySelectorAll("[data-viewer-switch]").forEach((button) => {
        button.addEventListener("click", () => {
          applyViewerPreference(document.documentElement.dataset.viewerEnabled === "false");
        });
      });

      window.archiveLanguage = {
        get: () => document.documentElement.dataset.lang || "ja",
        apply: applyLanguage
      };
      window.archiveViewerPreference = {
        get: () => document.documentElement.dataset.viewerEnabled !== "false",
        apply: applyViewerPreference
      };

      applyViewerPreference(localStorage.getItem(viewerKey) !== "off");
      applyLanguage(getSavedLanguage());
    </script>
  </body>
</html>
