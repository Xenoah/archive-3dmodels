---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BaseLayout
  title="規約 | 3Dモデル"
  titleEn="Terms | 3D Models"
  description="3Dモデルアーカイブのライセンスとダウンロード規約です。"
  descriptionEn="License and download terms for the 3D model archive."
>
  <a class="ghost-button" href={`${base}/`} data-lang-ja="モデル一覧へ戻る" data-lang-en="Back to models">モデル一覧へ戻る</a>
  <section class="intro">
    <div>
      <h1 data-lang-ja="規約" data-lang-en="Terms">規約</h1>
      <p
        data-lang-ja="ライセンス、商用利用、改変、再配布、クレジット要件は各モデルページの表示を正とします。Original ライセンスの場合はモデル本文の注記も確認してください。"
        data-lang-en="Each model page is the source of truth for license, commercial use, modification, redistribution, and credit requirements. For Original licenses, read the model notes too."
      >
        ライセンス、商用利用、改変、再配布、クレジット要件は各モデルページの表示を正とします。Original ライセンスの場合はモデル本文の注記も確認してください。
      </p>
    </div>
  </section>
  <section class="section markdown">
    <h2 data-lang-ja="ダウンロード" data-lang-en="Download">ダウンロード</h2>
    <p
      data-lang-ja="ZIPファイルにはソースファイルに加えて、生成された README と LICENSE テキストが含まれます。"
      data-lang-en="ZIP files include source files plus generated README and LICENSE text."
    >
      ZIPファイルにはソースファイルに加えて、生成された README と LICENSE テキストが含まれます。
    </p>
    <h2 data-lang-ja="下書き" data-lang-en="Draft">下書き</h2>
    <p
      data-lang-ja="下書きモデルは一覧、詳細ページ、ZIP生成から除外されます。"
      data-lang-en="Draft models are excluded from listings, detail pages, and ZIP generation."
    >
      下書きモデルは一覧、詳細ページ、ZIP生成から除外されます。
    </p>
  </section>
</BaseLayout>
