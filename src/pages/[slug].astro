---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModelViewer from "../components/ModelViewer.astro";
import models from "../data/models.generated.json";

export function getStaticPaths() {
  return models
    .filter((model) => model.status === "public" || model.status === "draft" || model.status === "hidden")
    .map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const credit = model.credit_required === true ? "Required" : model.credit_required === false ? "Not required" : "Check notes";
const boolLabel = (value) => (value === true ? "Allowed" : value === false ? "Not allowed" : "Check notes");
const relatedModels = models
  .filter((item) => item.status === "public" && item.slug !== model.slug)
  .map((item) => {
    const sharedTags = (item.tags ?? []).filter((tag) => (model.tags ?? []).includes(tag)).length;
    const categoryScore = item.category === model.category ? 1 : 0;
    return { ...item, relatedScore: sharedTags * 2 + categoryScore };
  })
  .filter((item) => item.relatedScore > 0)
  .sort((a, b) => b.relatedScore - a.relatedScore || a.title.localeCompare(b.title))
  .slice(0, 3);
---

<BaseLayout
  title={`${model.title} | 3D Models`}
  description={model.summary || `${model.title} download page`}
  image={model.assets.cover || ""}
>
  <a class="ghost-button" href={`${base}/`}>Back to models</a>

  <section class="detail-hero">
    <div class="viewer">
      {
        model.assets.viewer ? (
          <ModelViewer source={model.assets.viewer} title={`${model.title} 3D preview`} />
        ) : model.assets.cover ? (
          <img class="cover-image" src={model.assets.cover} alt="" />
        ) : (
          <div class="no-preview">
            <div class="model-fallback large" aria-hidden="true">
              <div class="cube-mark">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <strong>STL Source</strong>
            </div>
          </div>
        )
      }
    </div>

    <div class="detail-panel">
      <div class="panel-topline">Model Detail</div>
      <h1>{model.title}</h1>
      <p class="summary">{model.summary || "No summary provided."}</p>
      <div class="meta-row">
        <span class="pill">{model.category}</span>
        <span class="pill">{model.license}</span>
        <span class="pill">unit: {model.unit}</span>
        {model.version && <span class="pill">v{model.version}</span>}
      </div>

      <div class="action-strip" aria-label="Model actions">
        <a class="button" href={model.assets.download || "#"} aria-disabled={model.assets.download ? "false" : "true"}>
          Download ZIP
        </a>
        <a class="ghost-button" href="#details">Details</a>
        <a class="ghost-button" href="#description-title">Description</a>
      </div>

      <section class="download-box" aria-labelledby="download-title">
        <h2 id="download-title">Download</h2>
        <dl>
          <dt>License</dt>
          <dd>{model.license}</dd>
          <dt>Commercial use</dt>
          <dd>{boolLabel(model.commercial_use)}</dd>
          <dt>Modification</dt>
          <dd>{boolLabel(model.modification)}</dd>
          <dt>Redistribution</dt>
          <dd>{boolLabel(model.redistribution)}</dd>
          <dt>Credit</dt>
          <dd>{credit}</dd>
        </dl>
      </section>
    </div>
  </section>

  {model.assets.photos.length > 0 && (
    <section class="section" aria-labelledby="photos-title">
      <h2 id="photos-title">Photos</h2>
      <div class="gallery">
        {model.assets.photos.map((photo) => <img src={photo} alt="" loading="lazy" />)}
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="description-title">
    <h2 id="description-title">Description</h2>
    <article class="markdown" set:html={model.bodyHtml} />
  </section>

  <section class="section" id="details" aria-labelledby="spec-title">
    <h2 id="spec-title">Details</h2>
    <dl class="spec-list">
      <dt>Slug</dt>
      <dd>{model.slug}</dd>
      <dt>Category</dt>
      <dd>{model.category}</dd>
      <dt>Tags</dt>
      <dd>{(model.tags ?? []).join(", ") || "None"}</dd>
      <dt>Unit</dt>
      <dd>{model.unit}</dd>
      <dt>Scale</dt>
      <dd>{model.scale || "unspecified"}</dd>
      <dt>Source files</dt>
      <dd>{model.sourceCount}</dd>
      {model.assets.sources?.length > 0 && (
        <>
          <dt>Source list</dt>
          <dd>
            {model.assets.sources.map((source) => (
              <a href={source.url}>{source.name}</a>
            ))}
          </dd>
        </>
      )}
    </dl>
  </section>

  {relatedModels.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <h2 id="related-title">Related Models</h2>
      <div class="related-grid">
        {relatedModels.map((item) => (
          <a class="related-card" href={`${base}/${item.slug}/`}>
            <span>{item.category}</span>
            <strong>{item.title}</strong>
            <small>{(item.tags ?? []).slice(0, 3).map((tag) => `#${tag}`).join(" ")}</small>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="download-box section" aria-labelledby="download-bottom-title">
    <h2 id="download-bottom-title">Download ZIP</h2>
    <p class="summary">Check the license conditions and notes before downloading.</p>
    <a class="button" href={model.assets.download || "#"} aria-disabled={model.assets.download ? "false" : "true"}>
      Download ZIP
    </a>
  </section>
</BaseLayout>
