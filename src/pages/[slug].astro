---
import BaseLayout from "../layouts/BaseLayout.astro";
import ModelViewer from "../components/ModelViewer.astro";
import models from "../data/models.generated.json";

export function getStaticPaths() {
  return models
    .filter((model) => model.status === "public" || model.status === "draft" || model.status === "hidden")
    .map((model) => ({ params: { slug: model.slug }, props: { model } }));
}

const { model } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const creditJa = model.credit_required === true ? "必要" : model.credit_required === false ? "不要" : "注記を確認";
const creditEn = model.credit_required === true ? "Required" : model.credit_required === false ? "Not required" : "Check notes";
const boolLabelJa = (value) => (value === true ? "許可" : value === false ? "不可" : "注記を確認");
const boolLabelEn = (value) => (value === true ? "Allowed" : value === false ? "Not allowed" : "Check notes");
const formatDateTime = (value, locale) => {
  if (!value) return "";
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return "";
  return new Intl.DateTimeFormat(locale, {
    timeZone: "Asia/Tokyo",
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  }).format(date);
};
const uploadedAtJa = formatDateTime(model.uploadedAt, "ja-JP");
const uploadedAtEn = formatDateTime(model.uploadedAt, "en-US");
const relatedModels = models
  .filter((item) => item.status === "public" && item.slug !== model.slug)
  .map((item) => {
    const sharedTags = (item.tags ?? []).filter((tag) => (model.tags ?? []).includes(tag)).length;
    const categoryScore = item.category === model.category ? 1 : 0;
    return { ...item, relatedScore: sharedTags * 2 + categoryScore };
  })
  .filter((item) => item.relatedScore > 0)
  .sort((a, b) => b.relatedScore - a.relatedScore || a.title.localeCompare(b.title))
  .slice(0, 3);
---

<BaseLayout
  title={`${model.title} | 3Dモデル`}
  titleEn={`${model.title} | 3D Models`}
  description={model.summary || `${model.title} のダウンロードページです。`}
  descriptionEn={model.summary || `${model.title} download page`}
  image={model.assets.cover || ""}
>
  <a class="ghost-button" href={`${base}/`} data-lang-ja="モデル一覧へ戻る" data-lang-en="Back to models">モデル一覧へ戻る</a>

  <section class="detail-hero">
    <div class="viewer">
      {
        model.assets.viewer ? (
          <ModelViewer source={model.assets.viewer} title={`${model.title} 3D preview`} />
        ) : model.assets.cover ? (
          <img class="cover-image" src={model.assets.cover} alt="" />
        ) : (
          <div class="no-preview">
            <div class="model-fallback large" aria-hidden="true">
              <div class="cube-mark">
                <span></span>
                <span></span>
                <span></span>
              </div>
              <strong data-lang-ja="STLソース" data-lang-en="STL Source">STLソース</strong>
            </div>
          </div>
        )
      }
    </div>

      <div class="detail-panel">
      <div class="panel-topline" data-lang-ja="モデル詳細" data-lang-en="Model Detail">モデル詳細</div>
      <h1>{model.title}</h1>
      <div class="creator-line">
        <span data-lang-ja="作者" data-lang-en="Creator">作者</span>
        <strong>Xenoah</strong>
      </div>
      {model.summary ? (
        <p class="summary">{model.summary}</p>
      ) : (
        <p class="summary" data-lang-ja="概要はまだありません。" data-lang-en="No summary provided.">概要はまだありません。</p>
      )}
      <div class="meta-row">
        <span class="pill">{model.category}</span>
        <span class="pill">{model.license}</span>
        <span class="pill"><span data-lang-ja="単位:" data-lang-en="unit:">単位:</span> {model.unit}</span>
        {model.version && <span class="pill">v{model.version}</span>}
        {model.created && <span class="pill"><span data-lang-ja="作成:" data-lang-en="created:">作成:</span> {model.created}</span>}
        {model.uploaded && <span class="pill"><span data-lang-ja="アップロード:" data-lang-en="uploaded:">アップロード:</span> {model.uploaded}</span>}
      </div>

      <div
        class="action-strip"
        aria-label="モデル操作"
        data-lang-aria-label-ja="モデル操作"
        data-lang-aria-label-en="Model actions"
      >
        <a class="button" href="#download-notice" aria-disabled={model.assets.download ? "false" : "true"}>
          <span data-lang-ja="注意事項を確認してダウンロード" data-lang-en="Read notice and download">注意事項を確認してダウンロード</span>
        </a>
        <a class="ghost-button" href="#details" data-lang-ja="詳細" data-lang-en="Details">詳細</a>
        <a class="ghost-button" href="#description-title" data-lang-ja="説明" data-lang-en="Description">説明</a>
      </div>

      <section class="download-box" aria-labelledby="download-title">
        <h2 id="download-title" data-lang-ja="ダウンロード" data-lang-en="Download">ダウンロード</h2>
        <p class="summary">
          <span data-lang-ja="作者:" data-lang-en="Creator:">作者:</span> <strong>Xenoah</strong>
        </p>
        <dl>
          <dt data-lang-ja="ライセンス" data-lang-en="License">ライセンス</dt>
          <dd>{model.license}</dd>
          <dt data-lang-ja="商用利用" data-lang-en="Commercial use">商用利用</dt>
          <dd data-lang-ja={boolLabelJa(model.commercial_use)} data-lang-en={boolLabelEn(model.commercial_use)}>{boolLabelJa(model.commercial_use)}</dd>
          <dt data-lang-ja="改変" data-lang-en="Modification">改変</dt>
          <dd data-lang-ja={boolLabelJa(model.modification)} data-lang-en={boolLabelEn(model.modification)}>{boolLabelJa(model.modification)}</dd>
          <dt data-lang-ja="再配布" data-lang-en="Redistribution">再配布</dt>
          <dd data-lang-ja={boolLabelJa(model.redistribution)} data-lang-en={boolLabelEn(model.redistribution)}>{boolLabelJa(model.redistribution)}</dd>
          <dt data-lang-ja="クレジット" data-lang-en="Credit">クレジット</dt>
          <dd data-lang-ja={creditJa} data-lang-en={creditEn}>{creditJa}</dd>
        </dl>
      </section>
    </div>
  </section>

  {model.assets.photos.length > 0 && (
    <section class="section" aria-labelledby="photos-title">
      <h2 id="photos-title" data-lang-ja="写真" data-lang-en="Photos">写真</h2>
      <div class="gallery">
        {model.assets.photos.map((photo) => <img src={photo} alt="" loading="lazy" />)}
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="description-title">
    <h2 id="description-title" data-lang-ja="説明" data-lang-en="Description">説明</h2>
    <article class="markdown" set:html={model.bodyHtml} />
  </section>

  <section class="section" id="details" aria-labelledby="spec-title">
    <h2 id="spec-title" data-lang-ja="詳細" data-lang-en="Details">詳細</h2>
    <dl class="spec-list">
      <dt>Slug</dt>
      <dd>{model.slug}</dd>
      <dt data-lang-ja="カテゴリ" data-lang-en="Category">カテゴリ</dt>
      <dd>{model.category}</dd>
      <dt data-lang-ja="タグ" data-lang-en="Tags">タグ</dt>
      {(model.tags ?? []).length > 0 ? (
        <dd>{(model.tags ?? []).join(", ")}</dd>
      ) : (
        <dd data-lang-ja="なし" data-lang-en="None">なし</dd>
      )}
      <dt data-lang-ja="単位" data-lang-en="Unit">単位</dt>
      <dd>{model.unit}</dd>
      <dt data-lang-ja="スケール" data-lang-en="Scale">スケール</dt>
      {model.scale ? <dd>{model.scale}</dd> : <dd data-lang-ja="未指定" data-lang-en="unspecified">未指定</dd>}
      <dt data-lang-ja="作成日" data-lang-en="Created">作成日</dt>
      {model.created ? <dd>{model.created}</dd> : <dd data-lang-ja="未指定" data-lang-en="unspecified">未指定</dd>}
      <dt data-lang-ja="アップロード日" data-lang-en="Uploaded">アップロード日</dt>
      {model.uploaded ? <dd>{model.uploaded}</dd> : <dd data-lang-ja="未指定" data-lang-en="unspecified">未指定</dd>}
      {uploadedAtJa && (
        <>
          <dt data-lang-ja="アップロード日時" data-lang-en="Uploaded at">アップロード日時</dt>
          <dd data-lang-ja={uploadedAtJa} data-lang-en={uploadedAtEn}>{uploadedAtJa}</dd>
        </>
      )}
      <dt data-lang-ja="ソースファイル" data-lang-en="Source files">ソースファイル</dt>
      <dd>{model.sourceCount}</dd>
      {model.assets.sources?.length > 0 && (
        <>
          <dt data-lang-ja="ソース一覧" data-lang-en="Source list">ソース一覧</dt>
          <dd>
            {model.assets.sources.map((source) => (
              <a href={source.url}>{source.name}</a>
            ))}
          </dd>
        </>
      )}
    </dl>
  </section>

  {relatedModels.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <h2 id="related-title" data-lang-ja="関連モデル" data-lang-en="Related Models">関連モデル</h2>
      <div class="related-grid">
        {relatedModels.map((item) => (
          <a class="related-card" href={`${base}/${item.slug}/`}>
            <span>{item.category}</span>
            <strong>{item.title}</strong>
            <small>{(item.tags ?? []).slice(0, 3).map((tag) => `#${tag}`).join(" ")}</small>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="download-box section" id="download-notice" aria-labelledby="download-bottom-title">
    <h2 id="download-bottom-title" data-lang-ja="ZIPをダウンロード" data-lang-en="Download ZIP">ZIPをダウンロード</h2>
    <p
      class="summary"
      data-lang-ja="ダウンロード前にライセンス条件、注意事項、免責事項を確認してください。"
      data-lang-en="Review the license conditions, notices, and disclaimer before downloading."
    >
      ダウンロード前にライセンス条件、注意事項、免責事項を確認してください。
    </p>
    <div class="notice-scrollbox" tabindex="0" role="region" aria-label="Download notice">
      <div class="notice-lang-block">
        <h3>日本語</h3>
        <p>
          この3Dモデルおよび同梱ファイルは、作者 Xenoah が可能な範囲で確認したうえで配布していますが、
          完全性、正確性、安全性、特定用途への適合性、各環境での動作や造形結果を保証するものではありません。
        </p>
        <p>
          ダウンロード、加工、印刷、組み立て、使用、再配布、商用利用などは、各モデルページに記載されたライセンス条件と注意事項を確認したうえで、利用者自身の判断と責任で行ってください。
          3Dプリンタ、工具、材料、電子機器、取り付け対象物、周辺機器、人体、財産、データ、業務、第三者との関係に生じた損害、事故、不具合、トラブルについて、作者 Xenoah は責任を負いません。
        </p>
        <p>
          寸法、強度、耐熱性、絶縁性、耐荷重、固定方法、安全性が必要な用途では、必ず利用者自身で検証し、必要に応じて専門家に確認してください。
          法令、規格、メーカー保証、第三者の権利に反しないことも利用者自身で確認してください。
        </p>
      </div>
      <div class="notice-lang-block">
        <h3>English</h3>
        <p>
          These 3D models and bundled files are provided by Xenoah after reasonable checks, but they are provided as-is.
          Xenoah does not warrant completeness, accuracy, safety, fitness for a particular purpose, or successful operation, printing, assembly, or use in every environment.
        </p>
        <p>
          Downloading, modifying, printing, assembling, using, redistributing, or commercially using the files is done at your own discretion and responsibility after reviewing the license terms and notes on each model page.
          Xenoah is not responsible for any damage, accident, defect, failure, loss, dispute, or other trouble involving 3D printers, tools, materials, electronics, mounted objects, peripherals, people, property, data, business, or third parties.
        </p>
        <p>
          For uses that require dimensional accuracy, strength, heat resistance, insulation, load capacity, mounting reliability, or safety, you must verify suitability yourself and consult a qualified professional if needed.
          You are also responsible for ensuring that your use does not violate laws, standards, manufacturer warranties, or third-party rights.
        </p>
      </div>
    </div>
    <a class="button" href={model.assets.download || "#"} aria-disabled={model.assets.download ? "false" : "true"}>
      <span data-lang-ja="ZIPをダウンロード" data-lang-en="Download ZIP">ZIPをダウンロード</span>
    </a>
  </section>
</BaseLayout>
